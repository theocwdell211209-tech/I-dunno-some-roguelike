{
  "name": "duel-dive",
  "version": "1.0.0",
  "private": true,
  "description": "DUEL//DIVE mobile card roguelike",
  "scripts": {
    "dev": "python3 -m http.server 8080",
    "build:mobile": "node build-mobile.js",
    "mobile:sync": "npm run build:mobile && npx cap sync",
    "mobile:build": "npm run mobile:sync && cd android && ./gradlew assembleDebug",
    "mobile:android": "npx cap open android",
    "mobile:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/ios": "^7.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3"
  }
}
